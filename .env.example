# Names only: never commit real values. Copy to .env.local for local work; on Vercel set them in Project Settings > Environment Variables.
# REQUIRED = the app refuses to start / answers 500 or 503 without it. OPTIONAL = has a safe default.

# --- Which store the app uses: supabase | memory | auto. REQUIRED in production, set it to: supabase
# ---   supabase: needs SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY; fails to start if either is missing (never falls back).
# ---   memory:   the in-memory store, explicitly (data is lost on every restart and is NOT shared between serverless instances).
# ---   auto:     (default when empty) Supabase when both variables exist; otherwise memory locally, but in production
# ---             (NODE_ENV=production) it refuses to start instead of silently using memory.
# --- GET /api/health shows which store is active.
REPO_MODE=

# --- Supabase. REQUIRED when REPO_MODE=supabase. SERVICE_ROLE_KEY bypasses RLS: server-side only, never NEXT_PUBLIC_.
# --- (The db scripts pnpm db:check / db:seed / data:load-usage read these from .env.local.)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# OPTIONAL and currently unused by the app code.
SUPABASE_ANON_KEY=

# --- Session. REQUIRED in every environment: long random string (min 16 chars) that signs the session cookie. No fallback exists.
SESSION_SECRET=

# --- Representative login. OPTIONAL: leave EMPTY to disable rep login entirely (the rep screen then cannot be used).
REP_ACCESS_CODE=

# --- LLM providers. REQUIRED: at least one key. Without any key the app starts but /api/chat answers 503 (busy message).
GEMINI_API_KEY=
MISTRAL_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
# OPTIONAL: several keys per provider, comma separated (used in turn when a key is rate limited or rejected), e.g. GEMINI_API_KEYS=k1,k2
GEMINI_API_KEYS=
MISTRAL_API_KEYS=
GROQ_API_KEYS=
OPENROUTER_API_KEYS=
# OPTIONAL: fallback order and model overrides (empty = built-in defaults; verify ids in each provider's docs)
LLM_PROVIDER_ORDER=
GEMINI_MODEL=
GROQ_MODEL=
MISTRAL_MODEL=
OPENROUTER_MODEL=

# --- Behaviour flags. OPTIONAL.
# PARTICIPATION_FROM_REPRESENTATIVE: empty/"false" = the new car's participation comes from the catalogue default;
# "true" = a representative question is opened automatically and the comparison is provisional.
PARTICIPATION_FROM_REPRESENTATIVE=
# SHOW_PROVISIONAL_ALTERNATIVE: default "true"; only the literal "false" hides the provisional net.
SHOW_PROVISIONAL_ALTERNATIVE=
# Per-minute limits (in memory, per server instance). Defaults: 15 chat messages per session, 30 rep free-text answers.
CHAT_RATE_LIMIT_PER_MIN=
REP_TEXT_RATE_LIMIT_PER_MIN=

# --- Data location overrides. OPTIONAL, leave empty on Vercel (the files are bundled and read from process.cwd()/data).
NETWISE_DATA_DIR=
USAGE_CSV_PATH=
RULES_PATH=
