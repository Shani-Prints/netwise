# --- LLM providers (no secrets in git, server-side only: never use a NEXT_PUBLIC_ prefix).
# --- Default order (src/lib/ai/providers.ts, PROVIDER_ORDER): gemini -> mistral -> openrouter. Used by BOTH /api/chat and /api/ai-chat.
# --- Each provider accepts several keys, comma separated (…_API_KEYS), and/or one key (…_API_KEY).
# --- /api/ai-chat rotates keys least-recently-used and keeps cooldowns in Redis (below); /api/chat keeps them per server instance.
GEMINI_API_KEYS=
GEMINI_API_KEY=
MISTRAL_API_KEYS=
MISTRAL_API_KEY=
OPENROUTER_API_KEYS=
OPENROUTER_API_KEY=
# --- Groq is configured but NOT in the default order (blocked by NetFree, HTTP 418). To use it again (e.g. on Vercel):
# --- set LLM_PROVIDER_ORDER=gemini,groq,mistral,openrouter (or add 'groq' to PROVIDER_ORDER) and provide a key.
GROQ_API_KEYS=
GROQ_API_KEY=
# --- Switch providers off without a code change (comma separated), e.g. AI_DISABLED_PROVIDERS=groq
AI_DISABLED_PROVIDERS=
# --- Optional: override the order, e.g. LLM_PROVIDER_ORDER=openrouter,gemini. Empty = the default order.
LLM_PROVIDER_ORDER=
# Optional model overrides (verify current ids in each provider's docs)
GEMINI_MODEL=gemini-3-flash-preview
MISTRAL_MODEL=mistral-small-latest
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
GROQ_MODEL=llama-3.3-70b-versatile
# --- Shared state for key rotation/cooldowns across serverless instances (Upstash Redis, https://upstash.com).
# --- Leave empty locally: an in-memory store is used (it is lost between serverless invocations).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# --- Tuning (all optional)
AI_COOLDOWN_SECONDS=60
# how long a rejected key (401/403) or a blocked provider (418) is paused
AI_AUTH_COOLDOWN_SECONDS=3600
AI_SERVER_ERROR_COOLDOWN_SECONDS=15
AI_MAX_OUTPUT_TOKENS=1024
AI_MAX_HISTORY_MESSAGES=8
# --- Supabase. If SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY are empty the app uses an in-memory store (local demo only).
# --- The db scripts (pnpm db:check, db:seed, data:load-usage) read these from .env.local. Never commit real values;
# --- SUPABASE_SERVICE_ROLE_KEY bypasses RLS: server-side only, never in a NEXT_PUBLIC_ variable.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# --- Which store the app uses: supabase | memory | auto. Empty = auto.
# ---   supabase: requires SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY; fails to start if either is missing (never falls back).
# ---   memory:   the in-memory store, explicitly (data is lost on restart). The only way to use memory in production.
# ---   auto:     Supabase when both variables exist, otherwise memory; in production (NODE_ENV=production) it fails
# ---             loudly instead of silently using memory.
# --- Recommended on Vercel: REPO_MODE=supabase. GET /api/health shows which store is active.
REPO_MODE=
# --- Session: long random string (min 16 chars) that signs the session cookie. REQUIRED in every environment:
# --- the app refuses to run without it (there is no fallback secret).
SESSION_SECRET=
# --- Representative demo login. Leave EMPTY to disable rep login entirely (recommended outside demos).
REP_ACCESS_CODE=
# --- Participation of the employee in the NEW car.
# --- Empty or "false" (default): taken from the catalogue default (demo data); nobody is asked. A representative
# --- question exists only when explicitly asked (the agent's ask_representative tool).
# --- "true": a representative question is opened automatically after a comparison that still uses the default, and the
# --- comparison is provisional (see SHOW_PROVISIONAL_ALTERNATIVE in the code; default shows the provisional net).
PARTICIPATION_FROM_REPRESENTATIVE=
