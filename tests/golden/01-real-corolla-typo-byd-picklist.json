{
  "id": "01-real-corolla-typo-byd-picklist",
  "description": "REAL failure: 'מקורולה קורס ל byd חשמלי' + profile; then 'מנהלת מוצר ... ההשתתפות 250'; then the employee picks the BYD",
  "tags": ["real-failure", "current-car", "pick-list", "occupation", "zero"],
  "steps": [
    {
      "employee": "מה יקרה לנטו שלי אם אעבור למקורולה קורס ל byd חשמלי? כיום השכר הבסיסי שלי הוא 18500, אני בקבוצה ג, יש לי קרן השתלמות 2.5%, פנסיה 6%, נקודות זיכוי 2.75, יש לי 2 ילדים עד גיל 23.",
      "model": [
        { "tool": "save_employee_data", "input": { "group": "ג", "base": 18500, "pensionPct": 6, "studyFundPct": 2.5, "creditPoints": 2.75, "childrenUnder23": 2 } },
        { "say": "מעולה, תודה! מה העיסוק שלך, יש לך עמלות או בונוס, ומה ההשתתפות החודשית שלך ברכב הנוכחי?" }
      ],
      "expect": {
        "currentCarLabelContains": "COROLLA CROSS",
        "profile": { "group": "ג", "childrenUnder23": 2, "salaryInputs": { "base": 18500, "pensionPct": 6, "studyFundPct": 2.5, "creditPoints": 2.75 } },
        "text": { "contains": ["לא ברור לי לאיזה רכב התכוונת", "DOLPHIN", "ATTO 3", "SEAL"], "notMatches": ["שנת רישום", "באיזו שנה", "מחיר הרכב"] },
        "openQuestions": [],
        "totalQuestions": 0,
        "awaitingRepresentative": false
      }
    },
    {
      "employee": "מנהלת מוצר, אין לי עמלות ובונוסים, גובה ההשתתפות החודשית על הקורולה הוא 250",
      "model": [
        { "tool": "save_employee_data", "input": { "occupation": "מנהלת מוצר", "commissions": 0, "bonus": 0, "currentParticipation": 250 } },
        { "say": "תודה, רשמתי. לאיזה רכב תרצי להשוות?" }
      ],
      "expect": {
        "profile": { "occupation": "מנהל/ת מוצר", "group": "ג", "currentParticipation": 250, "salaryInputs": { "commissions": 0, "bonus": 0, "base": 18500 } },
        "todayOnly": "ok",
        "text": { "notContains": ["עמלות, בונוס", "לא מצאתי בהודעות שלך"] },
        "openQuestions": [],
        "replaced": false
      }
    },
    {
      "employee": "ATTO 3",
      "model": [
        { "tool": "calculate_comparison", "input": { "alternative": "CAR-10" } },
        { "say": "הנה ההשוואה: היום נטו {{todayNet}} ₪, עם הרכב החדש נטו {{alternativeNet}} ₪." }
      ],
      "expect": {
        "comparison": { "status": "ok", "hasNumbers": true, "alternativeLabelContains": "ATTO 3" },
        "openQuestions": []
      }
    }
  ]
}
