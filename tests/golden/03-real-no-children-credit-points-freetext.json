{
  "id": "03-real-no-children-credit-points-freetext",
  "description": "Same flow; the representative answers in free text: no credit points",
  "tags": [
    "real-failure",
    "children-zero",
    "credit-points"
  ],
  "steps": [
    {
      "employee": "אני מהנדסת תוכנה, משכורת בסיס 20000, בלי עמלות ובונוס, פנסיה 6%, קרן השתלמות 2.5%, אני לא יודעת כמה נקודות זיכוי יש לי, בלי ילדים. הרכב שלי כרגע קורולה קרוס 2025 עם השתתפות 300. מה יקרה אם אעבור לקיה נירו?",
      "model": [
        {
          "tool": "save_employee_data",
          "input": {
            "occupation": "מפתח/ת תוכנה",
            "base": 20000,
            "commissions": 0,
            "bonus": 0,
            "pensionPct": 6,
            "studyFundPct": 2.5,
            "childrenUnder23": 0,
            "currentParticipation": 300
          }
        },
        {
          "tool": "mark_field_unknown",
          "input": {
            "fields": [
              "creditPoints",
              "childrenUnder23"
            ]
          }
        },
        {
          "tool": "calculate_comparison",
          "input": {
            "alternative": "CAR-05"
          }
        },
        {
          "say": "בסדר, תודה."
        }
      ],
      "expect": {
        "profile": {
          "childrenUnder23": 0,
          "occupation": "מפתח/ת תוכנה",
          "currentParticipation": 300,
          "salaryInputs": {
            "base": 20000,
            "commissions": 0,
            "bonus": 0
          }
        },
        "openQuestions": [
          {
            "kind": "profile_field_unknown",
            "field": "creditPoints"
          }
        ],
        "questionLabels": [
          "נקודות הזיכוי"
        ],
        "awaitingRepresentative": true,
        "text": {
          "contains": [
            "נקודות הזיכוי",
            "שלחתי פנייה לנציג"
          ],
          "notMatches": [
            "מספר עובד",
            "שם מלא",
            "תעודת זהות"
          ]
        },
        "comparison": {
          "status": "missing",
          "hasNumbers": false
        }
      }
    },
    {
      "rep": {
        "field": "creditPoints",
        "text": "אין לה נקודות זיכוי",
        "interpretation": {
          "result": "values",
          "values": [
            {
              "field": "creditPoints",
              "value": "0"
            }
          ]
        }
      },
      "expect": {
        "repStatus": 200,
        "repInterpretation": "applied",
        "profile": {
          "salaryInputs": {
            "creditPoints": 0
          },
          "childrenUnder23": 0
        },
        "comparison": {
          "status": "ok",
          "hasNumbers": true
        },
        "openQuestions": []
      }
    }
  ]
}