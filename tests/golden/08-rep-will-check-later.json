{
  "id": "08-rep-will-check-later",
  "description": "The representative says she will check later: the question stays open and the employee only sees the fixed sentence; a typed answer later closes it",
  "tags": [
    "rep-outcome"
  ],
  "steps": [
    {
      "employee": "אני מנהלת מוצר בקבוצה ג, שכר בסיס 18500, בלי עמלות ובונוס, קרן השתלמות 2.5%, נקודות זיכוי 2.75, יש לי 2 ילדים, הרכב שלי כרגע קורולה קרוס עם השתתפות 300.",
      "model": [
        {
          "tool": "save_employee_data",
          "input": {
            "occupation": "מנהל/ת מוצר",
            "group": "ג",
            "base": 18500,
            "commissions": 0,
            "bonus": 0,
            "studyFundPct": 2.5,
            "creditPoints": 2.75,
            "childrenUnder23": 2,
            "currentParticipation": 300
          }
        },
        {
          "say": "תודה! מה אחוז הפנסיה?"
        }
      ],
      "expect": {
        "openQuestions": [],
        "currentCarLabelContains": "COROLLA CROSS"
      }
    },
    {
      "employee": "אין לי מושג כמה פנסיה",
      "model": [
        {
          "tool": "mark_field_unknown",
          "input": {
            "fields": [
              "pensionPct"
            ]
          }
        },
        {
          "say": "בסדר."
        }
      ],
      "expect": {
        "openQuestions": [
          {
            "kind": "profile_field_unknown",
            "field": "pensionPct"
          }
        ],
        "questionLabels": [
          "אחוז הפנסיה"
        ],
        "awaitingRepresentative": true,
        "text": {
          "contains": [
            "שלחתי פנייה לנציג"
          ]
        }
      }
    },
    {
      "rep": {
        "field": "pensionPct",
        "text": "אני בודקת ואחזור",
        "interpretation": {
          "result": "outcome",
          "outcome": "will_check_later"
        }
      },
      "expect": {
        "repStatus": 200,
        "repInterpretation": "will_check_later",
        "openQuestions": [
          {
            "kind": "profile_field_unknown",
            "field": "pensionPct"
          }
        ],
        "notices": {
          "contains": [
            "הנציג בודק"
          ]
        }
      }
    },
    {
      "rep": {
        "field": "pensionPct",
        "typed": "6"
      },
      "expect": {
        "repStatus": 200,
        "openQuestions": [],
        "fieldSources": {
          "pensionPct": "representative"
        },
        "profile": {
          "salaryInputs": {
            "pensionPct": 6
          }
        }
      }
    }
  ]
}
