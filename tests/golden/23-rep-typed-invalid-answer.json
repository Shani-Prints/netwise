{
  "id": "23-rep-typed-invalid-answer",
  "description": "A typed answer that is not a number is rejected with 400 and the question stays open",
  "tags": [
    "rep-typed"
  ],
  "steps": [
    {
      "employee": "אני מנהלת מוצר בקבוצה ג, שכר בסיס 18500, בלי עמלות ובונוס, קרן השתלמות 2.5%, נקודות זיכוי 2.75, יש לי 2 ילדים, הרכב שלי כרגע קורולה קרוס עם השתתפות 300.",
      "model": [
        {
          "tool": "save_employee_data",
          "input": {
            "occupation": "מנהל/ת מוצר",
            "group": "ג",
            "base": 18500,
            "commissions": 0,
            "bonus": 0,
            "studyFundPct": 2.5,
            "creditPoints": 2.75,
            "childrenUnder23": 2,
            "currentParticipation": 300
          }
        },
        {
          "say": "תודה! מה אחוז הפנסיה?"
        }
      ],
      "expect": {
        "openQuestions": [],
        "currentCarLabelContains": "COROLLA CROSS"
      }
    },
    {
      "employee": "אין לי מושג כמה פנסיה",
      "model": [
        {
          "tool": "mark_field_unknown",
          "input": {
            "fields": [
              "pensionPct"
            ]
          }
        },
        {
          "say": "בסדר."
        }
      ],
      "expect": {
        "openQuestions": [
          {
            "kind": "profile_field_unknown",
            "field": "pensionPct"
          }
        ],
        "questionLabels": [
          "אחוז הפנסיה"
        ],
        "awaitingRepresentative": true,
        "text": {
          "contains": [
            "שלחתי פנייה לנציג"
          ]
        }
      }
    },
    {
      "rep": {
        "field": "pensionPct",
        "typed": "הרבה"
      },
      "expect": {
        "repStatus": 400,
        "openQuestions": [
          {
            "kind": "profile_field_unknown",
            "field": "pensionPct"
          }
        ]
      }
    },
    {
      "rep": {
        "field": "pensionPct",
        "typed": "250"
      },
      "expect": {
        "repStatus": 400,
        "openQuestions": [
          {
            "kind": "profile_field_unknown",
            "field": "pensionPct"
          }
        ]
      }
    }
  ]
}
